# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database configuration (PostgreSQL / Prisma compatible)
DATABASE_URL="postgresql://user:password@localhost:5432/themeadows?schema=public"

# Authentication secret for signing admin session tokens
AUTH_SECRET="replace-with-secure-64-char-hex-secret-in-production"

# Initial Admin Setup (used to bootstrap the admin account securely on startup)
ADMIN_EMAIL="admin@themeadowskodaikanal.com"
ADMIN_INITIAL_PASSWORD="MeadowsAdmin!2026"

# Email Notification Service (SMTP / transactional email provider)
EMAIL_API_KEY=""
EMAIL_FROM="concierge@themeadowskodaikanal.com"
